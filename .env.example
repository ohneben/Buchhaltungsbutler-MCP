# ─── Required: BuchhaltungsButler API credentials ────────────────────────────
# API Client + Secret are your global API credentials (HTTP Basic auth).
# Find/create them in BuchhaltungsButler under Settings → API.
BB_API_CLIENT=your-api-client
BB_API_SECRET=your-api-secret

# The api_key identifies WHICH customer account to act on. Found in the
# customer's company data settings. This is the default; individual tool calls
# may override it via the optional `api_key` argument.
BB_API_KEY=your-customer-api-key

# ─── Optional ────────────────────────────────────────────────────────────────
# Transport: "stdio" (Claude Desktop) or "http" (hosted/Docker). Docker defaults to http.
MCP_TRANSPORT=http

# HTTP transport settings (ignored for stdio).
PORT=3000
HOST=0.0.0.0
MCP_HTTP_PATH=/mcp

# REQUIRED whenever HOST is not a loopback address (the default 0.0.0.0 is not).
# Without it the server refuses to start, because the endpoint can read, write
# and delete real accounting data. Clients send: Authorization: Bearer <token>
#   MCP_AUTH_TOKEN=$(openssl rand -hex 32)
MCP_AUTH_TOKEN=

# Comma-separated hostnames accepted in the Host header (DNS-rebinding
# protection). Set this when running behind a reverse proxy, e.g.
# MCP_ALLOWED_HOSTS=mcp.example.com. Unset: the check is skipped when
# MCP_AUTH_TOKEN is set (the token already defeats rebinding), and limited to
# localhost names when it is not.
MCP_ALLOWED_HOSTS=

# Escape hatch for the startup refusal above — only for an endpoint that
# genuinely nobody else can reach. Leaves the server unauthenticated.
MCP_ALLOW_INSECURE=

# Idle seconds before a session is swept, and the maximum number of concurrent
# sessions (the least recently used one is evicted beyond that).
MCP_SESSION_TTL=1800
MCP_MAX_SESSIONS=256

# Tool exposure policy. BB_READ_ONLY=true exposes only the 15 read-only tools;
# BB_TOOL_ALLOWLIST=accounts_get,receipts_get exposes only the named tools.
# Filtered tools are neither listed nor callable. Both unset = all 54 tools.
BB_READ_ONLY=
BB_TOOL_ALLOWLIST=

# Allow a tool call to override the configured BB_API_KEY and act on a
# different customer. Off by default: the value would be chosen by the model,
# so a hallucinated or injected key could reach another customer's books.
BB_ALLOW_API_KEY_OVERRIDE=

# Client-side rate limit (BB enforces 100 requests/customer/minute).
BB_RATE_LIMIT=90

# Override the API base URL (defaults to the value in the bundled spec).
# BB_BASE_URL=https://webapp.buchhaltungsbutler.de/api/v1
